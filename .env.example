# Copie para `.env` e ajuste. O binario carrega `.env` automaticamente em desenvolvimento.
# `cargo run` na raiz do projeto encontra o ficheiro.

PORTA=3000
DIRETORIO_ARMAZENAMENTO=./armazenamento
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file_storage

# --- Autenticacao admin (rotas /api/v1/admin/*) ---
# Preferencial: JWT obtido com POST /api/v1/auth/admin/login (email + palavra-passe na tabela admin_conta).
# Segredo para assinar JWT (obrigatorio em producao; em dev ha default inseguro no codigo).
# JWT_SECRET=uma-cadeia-longa-e-aleatoria

# Validade do token em segundos (default: 28800 = 8h)
# JWT_EXPIRACAO_SEGS=28800

# Se a tabela admin_conta estiver vazia apos as migracoes, o arranque cria a conta com estes valores:
ADMIN_BOOTSTRAP_EMAIL=admin@exemplo.local
ADMIN_BOOTSTRAP_PASSWORD=mude-esta-palavra-passe

# Compatibilidade: o mesmo valor ainda aceite como Bearer nas rotas admin (curl/scripts).
API_KEY_ADMIN=admin-chave-local-trocar

# Limite maximo por upload em bytes (default no codigo: 100 MiB se omitido)
# TAMANHO_MAXIMO_ARQUIVO_BYTES=104857600

# Corpo HTTP maximo para POST /api/v1/arquivos/lote (varios arquivos; default: max(50 MiB, 50x o limite por arquivo))
# TAMANHO_MAXIMO_CORPO_LOTE_BYTES=524288000

# Quantidade maxima de partes "arquivo" por pedido de lote (1–500, default 50)
# MAX_ARQUIVOS_POR_LOTE=50

# Cota opcional para o painel (barra % em GET /api/v1/admin/metricas/armazenamento). Soma dos tamanhos na BD vs esta cota.
# COTA_ARMAZENAMENTO_BYTES=1099511627776

# Opcional: URL base nas respostas de upload (se vazio, usa http://localhost:PORTA)
# BASE_URL=http://localhost:3000
