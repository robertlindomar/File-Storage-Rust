            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "arquivo",
                  "description": "Selecione um ficheiro qualquer (campo obrigatório: arquivo).",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/arquivos"
          },
          "response": []
        },
        {
          "name": "POST importacao em lote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "arquivo",
                  "description": "Varias partes com o mesmo nome de campo (adicione mais linhas 'arquivo' no Postman).",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "arquivo",
                  "description": "Segundo arquivo (opcional).",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/arquivos/lote",
            "description": "Resposta 200: JSON com `sucesso` (array de {id, url}) e `falhas` (array de {nome_arquivo, erro}). Limite de partes: env `MAX_ARQUIVOS_POR_LOTE` (default 50). Tamanho maximo do corpo: `TAMANHO_MAXIMO_CORPO_LOTE_BYTES`. Cada arquivo continua limitado por `TAMANHO_MAXIMO_ARQUIVO_BYTES`."
          },
          "response": []
        },
        {
          "name": "GET listar arquivos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/arquivos"
          },
          "response": []
        },
        {
          "name": "GET baixar arquivo por id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/arquivos/{{arquivoId}}"
          },
          "response": []
        },
        {
          "name": "DELETE deletar arquivo",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/arquivos/{{arquivoId}}"
          },
          "response": []
        }
      ]
    },
